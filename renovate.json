{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Group Go module minor/patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "go modules (minor/patch)"
    },
    {
      "description": "Group GitHub Actions minor/patch updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github actions (minor/patch)"
    },
    {
      "description": "Group container images used in tests (minor/patch)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "test container images (minor/patch)"
    },
    {
      "description": "Move the GoReleaser pins together",
      "matchDepNames": [
        "goreleaser/goreleaser"
      ],
      "groupName": "goreleaser"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images referenced in Go test sources (testcontainers)",
      "managerFilePatterns": [
        "/_test\\.go$/",
        "/^test/.*\\.go$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:docker\\.io/)?(?:prom/prometheus|grafana/loki|grafana/tempo|quay\\.io/thanos/thanos|grafana/mimir)):(?<currentValue>v?[0-9][A-Za-z0-9._-]*)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Tools run via 'go run pkg@version' in workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "go run (?<depName>golang\\.org/x/vuln)/cmd/govulncheck@(?<currentValue>v[0-9][^\\s]*)",
        "go run (?<depName>github\\.com/gohugoio/hugo)@(?<currentValue>v[0-9][^\\s]*)",
        "go run (?<depName>oras\\.land/oras)/cmd/oras@(?<currentValue>v[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "GoReleaser version pinned in the Makefile and in release.yml (kept in sync by one group)",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "GORELEASER_VERSION \\?= (?<currentValue>v[0-9][^\\s]*)",
        "goreleaser-action[\\s\\S]{0,300}?version: (?<currentValue>v[0-9][^\\s]*)"
      ],
      "depNameTemplate": "goreleaser/goreleaser",
      "datasourceTemplate": "github-releases"
    }
  ]
}
