{{- /* Full-text index of one documentation version, fetched by assets/js/search.js on first use. Hugo
       writes one for each version: /docs/search-index.json, /docs/main/search-index.json and so on. */ -}}
{{- $v := partial "docs-version.html" . -}}
{{- $nav := dict -}}
{{- range $v.nav }}{{ $group := .title }}{{ range .pages }}{{ $nav = merge $nav (dict (index (split . " | ") 0) $group) }}{{ end }}{{ end -}}
{{- $out := slice -}}
{{- range where site.RegularPages "Params.version" $v.name -}}
  {{- $key := strings.TrimSuffix ".md" (strings.TrimPrefix "docs/" (.Params.source | default "")) -}}
  {{- $heads := slice -}}
  {{- range .Fragments.Headings }}{{ range .Headings }}{{ $heads = $heads | append (slice .ID .Title) }}{{ end }}{{ end -}}
  {{- $out = $out | append (dict "t" .Title "u" .RelPermalink "g" (index $nav $key | default "Docs") "h" $heads "b" (.Plain | htmlUnescape | replaceRE "\\s+" " ")) -}}
{{- end -}}
{{- $out | jsonify -}}
