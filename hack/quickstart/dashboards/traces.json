      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Server spans with a 5xx status",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
