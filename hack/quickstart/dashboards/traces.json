{
  "id": null,
  "uid": "demo-traces",
  "title": "Traces and latency",
  "description": "Latency heatmap from metrics next to TraceQL searches (recent, errors, slow, downstream calls). Open a trace from the table; its Logs button runs a Loki query for the trace id (trace to logs).",
  "tags": [
    "querdian-demo",
    "querdian"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "title": "Querdian demo",
      "tags": [
        "querdian-demo"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "description": "Namespaces (= services) you are allowed to see. Querdian filters the list per user.",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "regex": "",
        "allValue": ".+"
      },
      {
        "name": "min_duration",
        "label": "Slow if span duration >",
        "type": "custom",
        "query": "100ms,250ms,500ms,1s,2s",
        "description": "",
        "current": {
          "selected": true,
          "text": "500ms",
          "value": "500ms"
        },
        "options": [
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": false,
            "text": "250ms",
            "value": "250ms"
          },
          {
            "selected": true,
            "text": "500ms",
            "value": "500ms"
          },
          {
            "selected": false,
            "text": "1s",
            "value": "1s"
          },
          {
            "selected": false,
            "text": "2s",
            "value": "2s"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "traceid",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "description": "Paste a trace id (for example from the Logs dashboard) to see it in the Trace panel.",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latency from metrics",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "heatmap",
      "title": "Request duration heatmap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Requests per duration bucket (http_request_duration_seconds). The payment-service incident shows as a band moving up.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64
        },
        "cellGap": 1,
        "rowsFrame": {
          "layout": "auto"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency by namespace",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(http_request_duration_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{namespace}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "TraceQL search (through Querdian)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Recent traces",
      "description": "TraceQL: { resource.k8s.namespace.name =~ ... && kind = server }. For users whose policy cannot prove the root span, Querdian removes the root name and service and recomputes start and duration from the matching spans (see docs/limitations.md).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.k8s.namespace.name =~ \"$namespace\" && kind = server }",
          "limit": 20,
          "tableType": "traces",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Error traces",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.k8s.namespace.name =~ \"$namespace\" && status = error }",
          "limit": 20,
          "tableType": "traces",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Slow spans",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.k8s.namespace.name =~ \"$namespace\" && kind = server && duration > $min_duration } | select(span.http.route)",
          "limit": 20,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Failing downstream calls",
      "description": "Client spans that failed: database errors and timeouts towards payment-service or acme-pay.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.k8s.namespace.name =~ \"$namespace\" && kind = client && status = error } | select(span.peer.service, span.db.system)",
          "limit": 20,
          "tableType": "spans",
          "filters": []
