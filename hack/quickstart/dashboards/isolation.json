{
  "id": null,
  "uid": "demo-isolation",
  "title": "What can I see?",
  "description": "Makes Querdian's isolation visible: the namespaces, labels, log lines and spans that THIS user can see. Log in as alice, bob and carol and compare. The customer_id label is redacted for the order team.",
