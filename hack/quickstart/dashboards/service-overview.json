{
  "id": null,
  "uid": "demo-service-overview",
  "title": "Service overview (RED)",
  "description": "Rate, errors and duration of the two sample services, plus saturation. Every query goes through Querdian with the token of the logged-in user, so each user only sees the namespaces the policy allows.",
  "tags": [
    "querdian-demo",
    "querdian"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "type": "dashboards",
      "title": "Querdian demo",
      "tags": [
        "querdian-demo"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
