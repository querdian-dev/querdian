        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total, namespace)",
        "refresh": 2,
        "definition": "label_values(http_requests_total, namespace)",
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "hide": 0,
        "description": "Namespaces (= services) you are allowed to see. Querdian filters the list per user.",
