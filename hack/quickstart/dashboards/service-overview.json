        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_requests_total{namespace=~\"$namespace\"}, route)",
        "refresh": 2,
        "definition": "label_values(http_requests_total{namespace=~\"$namespace\"}, route)",
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "hide": 0,
